<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required under the hardened runtime to ask Dia for its front tab.
         Without this the Apple event is refused (-1743) even after you've
         approved Tally in System Settings › Privacy › Automation. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
